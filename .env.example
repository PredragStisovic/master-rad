# Application
NODE_ENV=development
PORT=3000

# Database connection used by the app.
# Running on the host (npm run start:dev) -> localhost + the published port.
# Running in docker compose -> the app service overrides this with postgres:5432.
DATABASE_URL=postgresql://root:root@localhost:5433/jira_clone_db

# Consumed by docker-compose.yaml
POSTGRES_USER=root
POSTGRES_PASSWORD=root
POSTGRES_DB=jira_clone_db
POSTGRES_PORT=5433
APP_PORT=3000
